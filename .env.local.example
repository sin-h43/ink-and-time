# Copy this file to .env.local and fill in real values.
# The app runs fine with none of these set — tasks persist locally via IndexedDB
# regardless. These only matter once you wire up cloud sync / Spotify.

# --- Supabase (see lib/supabaseSync.ts) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Spotify OAuth PKCE (see lib/spotify.ts) ---
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
SPOTIFY_CLIENT_SECRET=
